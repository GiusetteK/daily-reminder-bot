{
  "manifest_version": 3,
  "name": "Promemoria personali",
  "version": "1.2.0",
  "description": "Organizza attività e promemoria in una dashboard privata dentro Chrome.",
  "permissions": ["storage", "alarms", "notifications"],
  "action": {
    "default_title": "Promemoria personali",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icons/reminder.svg"
  }
}
