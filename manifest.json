{
  "manifest_version": 3,
  "name": "Promemoria personali",
  "version": "1.0.0",
  "description": "Aggiungi attività e ricevi promemoria direttamente in Chrome. I dati restano sul tuo dispositivo.",
  "permissions": ["storage", "alarms", "notifications"],
  "action": {
    "default_title": "Promemoria personali",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icons/reminder.svg"
  }
}