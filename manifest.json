{
  "manifest_version": 3,
  "name": "Promemoria personali",
  "version": "1.3.0",
  "description": "Organizza i tuoi promemoria in Chrome e importa eventi da un calendario .ics.",
  "permissions": ["storage", "alarms", "notifications"],
  "action": {
    "default_title": "Promemoria personali",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icons/reminder.svg"
  }
}
